{
  "name": "claude-chat-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Claude API を使った趣味のデスクトップチャットアプリ Electron 版",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "local.claude-chat.electron",
    "productName": "ClaudeChat-Electron",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/node": "^26.6.5",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "typescript": "^7.0.2"
  }
}
