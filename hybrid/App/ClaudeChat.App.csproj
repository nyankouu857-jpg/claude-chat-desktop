<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ClaudeChat</AssemblyName>
    <RootNamespace>ClaudeChat.App</RootNamespace>
    <Version>0.2.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <WebRoot>$(MSBuildProjectDirectory)\..\web</WebRoot>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 手元のビルドが latest で上書きされないよう、コミットは CI のビルドにだけ埋め込む -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <ProjectReference Include="..\Core\ClaudeChat.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildWeb" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebRoot)" Condition="!Exists('$(WebRoot)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebRoot)" />
  </Target>

  <!-- 画面は exe に埋め込み、配布物を exe 1 つにする。SkipWebBuild でも埋め込みは必ず行う -->
  <Target Name="EmbedWeb" BeforeTargets="BeforeBuild" DependsOnTargets="BuildWeb">
    <Error Condition="!Exists('$(WebRoot)\dist\index.html')" Text="画面がビルドされていません。hybrid/web で npm ci と npm run build を実行してください" />
    <ItemGroup>
      <WebAsset Include="$(WebRoot)\dist\**\*" />
      <EmbeddedResource Include="@(WebAsset)" LogicalName="web/%(WebAsset.RecursiveDir)%(WebAsset.Filename)%(WebAsset.Extension)" />
    </ItemGroup>
  </Target>

</Project>
