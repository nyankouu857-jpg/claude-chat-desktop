<Window x:Class="ClaudeChat.Native.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <StackPanel Margin="24,20">
        <TextBlock Text="APIキー" />
        <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,0" />
        <TextBlock x:Name="ApiKeyState" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock Text="システムプロンプト" Margin="0,16,0,0" />
        <TextBox x:Name="SystemPromptBox" Margin="0,6,0,0" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="キャンセル" Style="{StaticResource FlatButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
