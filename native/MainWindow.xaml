<Window x:Class="ClaudeChat.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeChat Native"
        Width="1200" Height="820" MinWidth="720" MinHeight="480"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8,12">
                <Button DockPanel.Dock="Top" Style="{StaticResource FlatButton}" Padding="12,10" Click="NewChat_Click">
                    <TextBlock Text="+ 新しいチャット" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Button>
                <TextBlock DockPanel.Dock="Top" Text="履歴" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="12,16,0,6" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Padding="12,10" Click="Settings_Click">
                    <TextBlock Text="設定" Foreground="{DynamicResource MutedBrush}" />
                </Button>
                <ListBox x:Name="ConversationList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ConversationList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="12,7,4,7" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="×" ToolTip="削除" Padding="6,0"
                                        Style="{StaticResource FlatButton}" Foreground="{DynamicResource MutedBrush}"
                                        Tag="{Binding Id}" Click="DeleteConversation_Click" />
                                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0" Fill="{DynamicResource AccentBrush}"
                                         Visibility="{Binding StreamingVisibility}" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                <DockPanel>
                    <TextBlock x:Name="UsageLabel" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ChatTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessagesPanel" MaxWidth="760" Margin="24,24,24,40" />
            </ScrollViewer>

            <Border x:Name="Composer" Grid.Row="2" MaxWidth="760" Margin="24,0,24,20" Padding="12,10,12,8"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16"
                    AllowDrop="True" PreviewDragOver="Composer_DragOver" PreviewDrop="Composer_Drop">
                <StackPanel>
                    <ItemsControl x:Name="AttachmentTray">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,8">
                                    <Border Width="64" Height="64" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                    </Border>
                                    <Button Content="×" Style="{StaticResource FlatButton}" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{DynamicResource TextBrush}" Foreground="{DynamicResource BgBrush}"
                                            Tag="{Binding}" Click="RemoveAttachment_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <TextBox x:Name="PromptBox" Style="{StaticResource PlainInput}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="24" MaxHeight="300" PreviewKeyDown="PromptBox_PreviewKeyDown" TextChanged="PromptBox_TextChanged" />
                        <TextBlock x:Name="PromptPlaceholder" Text="Claude にメッセージを送る" Foreground="{DynamicResource MutedBrush}"
                                   IsHitTestVisible="False" FontSize="15" Margin="2,0,0,0" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="画像" Style="{StaticResource FlatButton}" Click="Attach_Click" />
                        <CheckBox x:Name="WebSearchToggle" DockPanel.Dock="Left" Content="Web検索" VerticalAlignment="Center" Margin="8,0" FontSize="13"
                                  Foreground="{DynamicResource MutedBrush}" Click="WebSearchToggle_Click" />
                        <Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止" Style="{StaticResource DangerButton}" Visibility="Collapsed" Click="Stop_Click" />
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="送信" Style="{StaticResource PrimaryButton}" Click="Send_Click" />
                        <ComboBox x:Name="EffortSelect" DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="130" SelectionChanged="EffortSelect_SelectionChanged" />
                        <ComboBox x:Name="ModelSelect" DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="120" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectionChanged="ModelSelect_SelectionChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
